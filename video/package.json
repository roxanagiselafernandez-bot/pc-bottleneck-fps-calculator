{
  "name": "edicion-videos-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Plantillas Remotion para vender edición de video (reels con subtítulos y promos) armadas con Claude.",
  "scripts": {
    "studio": "remotion studio",
    "render:promo": "remotion render PromoReel out/promo.mp4",
    "render:subs": "remotion render ReelSubtitulado out/reel-subtitulado.mp4",
    "render:cliente": "remotion render ReelSubtitulado out/cliente.mp4 --props=./clientes/ejemplo.json",
    "still": "remotion still PromoReel out/preview.png --frame=60",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "@remotion/zod-types": "4.0.533",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.533",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
